{
  "name": "velthy-listen-together",
  "version": "1.0.0",
  "description": "Velthy Listen Together — party server (NestJS). A party is a six-character code, up to five signed-in devices, and one playback state every device re-derives its playhead from.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node startup.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "start:prod": "node startup.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "test": "node --import tsx --test checks/*.test.ts",
    "smoke": "node checks/smoke.mjs",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"{src,checks,scripts}/**/*.mjs\" \"{src,checks}/**/*.ts\" startup.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "cloudflared": "^0.7.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
