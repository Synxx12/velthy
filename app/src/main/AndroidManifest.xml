<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tells Wi-Fi from mobile data, so the matching quality ceiling applies. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Saving a track to Downloads outlives the screen it was asked from. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Reading local audio files across the device -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Bluetooth & Nearby Audio Device Detection -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <!-- Wi-Fi & Smart TV / Cast Device Discovery (SSDP / UPnP Multicast / NSD) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />

    <!--
      Only for API 28 and below. From 29 the app writes to the shared Downloads
      folder through MediaStore, which grants access to the rows it created and
      needs no permission at all — and this one stops being grantable there.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Package visibility for the Dolby Atmos panel the spatial audio row hands
      the user to. Without this, API 30+ hides those packages from the launcher
      lookup and the row would fall back to plain sound settings even on a
      device that ships the Atmos app.
    -->
    <queries>
        <package android:name="com.dolby.dax2appui" />
        <package android:name="com.dolby.daxappui" />
        <package android:name="com.dolby.dolby234" />
        <package android:name="com.atc.daxappUI" />
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".VelthyApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Velthy"
        tools:targetApi="34">

        <!--
          One UI 7+ only routes an app's ongoing notification to Live
          Notifications / the Now Bar if the app opts in here. Ignored by every
          other OEM. Samsung additionally gates the non-media Live Notification
          extras behind a per-package allowlist; the media card does not need it.
        -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <!--
          Portrait only. Every screen is laid out for a tall single column —
          the player's artwork square, the frosted bars, the floating tab bar —
          and none of it has a landscape design to fall back on.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Velthy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Discord OAuth2 deep link redirect -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="discord-1541308554173227080"
                    android:host="authorize"
                    android:path="/callback" />
                <data
                    android:scheme="discord-1541308554173227080"
                    android:path="/authorize/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="velthy"
                    android:host="discord"
                    android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="musique"
                    android:host="discord"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Downloads. Not exported: it is started by the app and by its own
          cancel action, and nothing outside has any business queueing work.
        -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Home-screen widgets. Two providers so the picker lists a 2×2 and a 4×2,
          both of which are the same widget resized — see MediaWidget.
        -->
        <receiver
            android:name=".widget.MediaWidgetSquare"
            android:exported="false"
            android:label="@string/widget_square_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_square" />
        </receiver>

        <receiver
            android:name=".widget.MediaWidgetWide"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_wide" />
        </receiver>

        <!-- The transport buttons. Reached only by this app's own PendingIntents. -->
        <receiver
            android:name=".widget.MediaWidgetActions"
            android:exported="false" />
    </application>

</manifest>
