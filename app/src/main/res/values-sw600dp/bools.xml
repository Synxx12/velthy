<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tablets rotate. 600dp on the shortest side is the line Android itself
      draws for "this is not a phone", and past it the trade changes: there is
      room for the two-column player, and a tablet held in landscape is the
      ordinary way to hold one rather than a phone being turned on its side for
      a moment.

      See the values/bools.xml copy for the full reasoning, and MainActivity for
      how the phone case is handled inside the player.
    -->
    <bool name="allow_rotation">true</bool>
</resources>
